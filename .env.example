# Live Graph Agent Chat — dev environment
# Copy to .env and fill in real values. .env is git-ignored; this file is not.
# Every value below is required unless marked optional — the app fails fast at
# startup if one is missing (plan D11). No value here is a real secret.

APP_ENV=dev

# --- 5.1 Security and API ---
# Shared secret for all /api routes except health. Generate with: openssl rand -hex 32
API_TOKEN=changeme-generate-with-openssl-rand-hex-32
# Comma-separated allowed origins, e.g. http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- 5.2 Limits ---
MAX_DOCUMENTS=100
MAX_FILE_SIZE_MB=20
# pdf,txt,docx only (D23 — no legacy .doc)
ALLOWED_EXTENSIONS=pdf,txt,docx
INGEST_CHUNK_CHARS=2000
INGEST_RETRIES=3
AGENT_MAX_REWRITES=2
# How many extra search-query variants (rephrasings + a HyDE-style hypothetical
# passage) the retrieve step generates and runs alongside the original query, then
# merges. 0 disables expansion (one query, today's behavior).
AGENT_QUERY_EXPANSIONS=2
RETRIEVAL_LIMIT=10
GRAPH_SNAPSHOT_LIMIT=500
GRAPH_GROUP_ID=lgac-dev

# --- 5.3 Storage ---
DATA_DIR=uploads
# MYSQL_HOST=mysql resolves to compose/mysql.yml's container on the lgac network.
# Running your own MySQL instead (its own container, or any external instance)?
# Comment compose/mysql.yml out of docker-compose.yml's include: list (drops the
# depends_on too — see compose/backend.yml), add backend to whatever Docker network
# that instance is reachable on (see compose/backend.yml's shared_infra example), and
# point this at its container name or address. The app connects as MYSQL_USER, using
# a database and user that must already exist there — this app never creates them.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=lgac
MYSQL_USER=lgac_app
MYSQL_PASSWORD=changeme-mysql-app-password
# Only used by compose/mysql.yml's own MySQL container to bootstrap itself and for its
# healthcheck — the app never connects as root. Optional: leave unset if you supply
# your own MySQL (see above), since nothing reads it in that case.
MYSQL_ROOT_PASSWORD=changeme-mysql-root-password

# --- 5.4 Neo4j ---
# NEO4J_URI=bolt://neo4j:7687 resolves to compose/neo4j.yml's container on the lgac
# network. Running your own Neo4j instead? Comment compose/neo4j.yml out of
# docker-compose.yml's include: list and point this at wherever that instance is
# actually reachable from inside the backend container (host.docker.internal, or its
# real hostname/IP), keeping the bolt port.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme-neo4j-password
NEO4J_DATABASE=neo4j

# --- 5.5 Extraction and embedding models (Graphiti) ---
# Fill in your own OpenAI-compatible LLM and embedding provider (OpenAI, Azure
# OpenAI, OpenRouter, or any other OpenAI-compatible endpoint). No code change
# is required for any provider — the client only reads these variables (plan D10).
LLM_BASE_URL=changeme-your-llm-provider-base-url
LLM_API_KEY=changeme-your-llm-provider-api-key
LLM_MODEL=changeme-your-llm-model-name
LLM_SMALL_MODEL=changeme-your-llm-small-model-name
LLM_TEMPERATURE=0
EMBEDDING_BASE_URL=changeme-your-embedding-provider-base-url
EMBEDDING_API_KEY=changeme-your-embedding-provider-api-key
EMBEDDING_MODEL=changeme-your-embedding-model-name

# --- 5.6 Agent model ---
AGENT_LLM_BASE_URL=changeme-your-agent-llm-provider-base-url
AGENT_LLM_API_KEY=changeme-your-agent-llm-provider-api-key
AGENT_LLM_MODEL=changeme-your-agent-llm-model-name
AGENT_LLM_TEMPERATURE=0

# --- 5.7 Langfuse (self-hosted, optional — D25) ---
# Tracing is entirely optional. With LANGFUSE_ENABLED=false (the default),
# the app never imports or calls the Langfuse SDK (app/tracing.py), and the
# langfuse/postgres/clickhouse/redis/minio compose services never start — they
# all carry `profiles: [langfuse]`. The values below are only read when you
# set LANGFUSE_ENABLED=true AND start those services with:
#   docker compose --profile langfuse up -d
LANGFUSE_ENABLED=false
# Inside compose: http://langfuse-web:3000 . From the host: http://localhost:3000
LANGFUSE_HOST=http://langfuse-web:3000
# Created in the Langfuse UI after first start (plan T6.1)
LANGFUSE_PUBLIC_KEY=changeme-langfuse-public-key
LANGFUSE_SECRET_KEY=changeme-langfuse-secret-key
NEXTAUTH_SECRET=changeme-generate-with-openssl-rand-hex-32
NEXTAUTH_URL=http://localhost:3000
SALT=changeme-generate-with-openssl-rand-hex-32
ENCRYPTION_KEY=changeme-64-hex-chars-from-openssl-rand-hex-32
# Optional bootstrap of org, project, and admin user — leave unset to skip
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=changeme-postgres-password
POSTGRES_DB=langfuse
POSTGRES_VERSION=17
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=changeme-clickhouse-password
REDIS_AUTH=changeme-redis-password
MINIO_ROOT_USER=langfuse-minio
MINIO_ROOT_PASSWORD=changeme-minio-password

# --- 5.8 Frontend (build-time, non-secret) ---
# Optional. The frontend build must never read API_TOKEN.
VITE_APP_TITLE=Live Graph Agent Chat
