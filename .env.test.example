# Live Graph Agent Chat — test environment
# Copy to .env.test. Used only by integration test runs (plan §5.9). Every
# stateful value here is deliberately different from .env so the dev and test
# stacks can run side by side without ever sharing data. A missing value fails
# loudly instead of falling back to a dev value — there is no fallback between
# the two files.

APP_ENV=test

# --- 5.1 Security and API ---
API_TOKEN=changeme-generate-with-openssl-rand-hex-32-test
CORS_ORIGINS=http://localhost:5173

# --- 5.2 Limits ---
MAX_DOCUMENTS=100
MAX_FILE_SIZE_MB=20
ALLOWED_EXTENSIONS=pdf,txt,docx
INGEST_CHUNK_CHARS=2000
INGEST_RETRIES=3
AGENT_MAX_REWRITES=2
AGENT_QUERY_EXPANSIONS=2
RETRIEVAL_LIMIT=10
GRAPH_SNAPSHOT_LIMIT=500
# Must start with test_ — the integration guard refuses to run otherwise (§5.9)
GRAPH_GROUP_ID=test_lgac

# --- 5.3 Storage ---
# Separate path from the dev DATA_DIR
DATA_DIR=uploads-test
MYSQL_HOST=mysql
# Different published host port from dev, e.g. 13306
MYSQL_PORT=13306
# Must end in _test — the integration guard refuses to run otherwise (§5.9)
MYSQL_DATABASE=lgac_test
MYSQL_USER=lgac_app_test
MYSQL_PASSWORD=changeme-mysql-app-password-test
MYSQL_ROOT_PASSWORD=changeme-mysql-root-password-test

# --- 5.4 Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme-neo4j-password-test
# Must end in _test — the integration guard refuses to run otherwise (§5.9)
NEO4J_DATABASE=neo4j_test

# --- 5.5 Extraction and embedding models (Graphiti) ---
# Tests use fake model clients (tests/fakes.py) and never call these endpoints
# for real, so any placeholder value is fine here — nothing dereferences it.
LLM_BASE_URL=http://llm.invalid/v1
LLM_API_KEY=placeholder-llm-key
LLM_MODEL=placeholder-model
LLM_SMALL_MODEL=placeholder-small-model
LLM_TEMPERATURE=0
EMBEDDING_BASE_URL=http://embed.invalid/v1
EMBEDDING_API_KEY=placeholder-embedding-key
EMBEDDING_MODEL=placeholder-embedding-model

# --- 5.6 Agent model ---
AGENT_LLM_BASE_URL=http://agent.invalid/v1
AGENT_LLM_API_KEY=placeholder-agent-key
AGENT_LLM_MODEL=placeholder-agent-model
AGENT_LLM_TEMPERATURE=0

# --- 5.7 Langfuse (self-hosted, optional — D25) ---
# Optional, same as .env.example. Every test fixture already sets
# LANGFUSE_ENABLED=False directly, so this default does not affect pytest.
# Known gap: compose/langfuse-app.yml hard-codes langfuse-web's host port to
# 3000 (no env variable for it), the same gap neo4j.yml documents for the
# bolt port — so the dev and test stacks cannot both run the langfuse
# profile at the same time yet.
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:13000
LANGFUSE_PUBLIC_KEY=changeme-langfuse-public-key-test
LANGFUSE_SECRET_KEY=changeme-langfuse-secret-key-test
NEXTAUTH_SECRET=changeme-generate-with-openssl-rand-hex-32-test
NEXTAUTH_URL=http://localhost:13000
SALT=changeme-generate-with-openssl-rand-hex-32-test
ENCRYPTION_KEY=changeme-64-hex-chars-from-openssl-rand-hex-32-test
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
POSTGRES_USER=langfuse_test
POSTGRES_PASSWORD=changeme-postgres-password-test
POSTGRES_DB=langfuse_test
POSTGRES_VERSION=17
CLICKHOUSE_USER=langfuse_test
CLICKHOUSE_PASSWORD=changeme-clickhouse-password-test
REDIS_AUTH=changeme-redis-password-test
MINIO_ROOT_USER=langfuse-minio-test
MINIO_ROOT_PASSWORD=changeme-minio-password-test

# --- 5.8 Frontend (build-time, non-secret) ---
VITE_APP_TITLE=Live Graph Agent Chat (test)

# --- Compose project (§5.9) ---
# Passed with: docker compose -p lgac-test --env-file .env.test ...
COMPOSE_PROJECT_NAME=lgac-test
